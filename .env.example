# Google Sheets API key (required for reading salon data)
NEXT_PUBLIC_GOOGLE_API_KEY=your_google_api_key_here

# Supabase (required for data persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Neon (required for salones con dataSource = "neon", ej. The Woman Cave)
# Server-only: NUNCA usar el prefijo NEXT_PUBLIC_ aquí, esta connection string
# no debe llegar al navegador. Se usa desde app/api/salon-data/neon/route.ts.
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Un proyecto Neon por app de salón: agrega una variable NEON_DATABASE_URL_<NOMBRE>
# por cada proyecto extra. La app busca cada salón en todas y usa la que lo tenga.
NEON_DATABASE_URL_MARTHA=postgresql://user:password@host/dbname?sslmode=require
